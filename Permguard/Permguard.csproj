<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>12</LangVersion>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
    <Title>Permguard</Title>
    <PackageId>Permguard</PackageId>
    <Version>0.0.1</Version>
    <Authors>Nitro Agility S.r.l.</Authors>
    <Description>Official .NET SDK for the native Permguard PDP v1 HTTP and gRPC interfaces.</Description>
    <Copyright>Copyright (c) 2022 Nitro Agility S.r.l.</Copyright>
    <PackageProjectUrl>https://www.permguard.com/</PackageProjectUrl>
    <PackageLicenseFile>LICENSE</PackageLicenseFile>
    <PackageIcon>symbol.png</PackageIcon>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <RepositoryUrl>https://github.com/permguard/sdk-netcore</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>authorization;security;pdp;permguard;grpc</PackageTags>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <Protobuf Include="Grpc/pdp.proto" GrpcServices="Client" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Google.Protobuf" Version="3.30.0" />
    <PackageReference Include="Grpc.Net.Client" Version="2.70.0" />
    <PackageReference Include="Grpc.Tools" Version="2.70.0" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../LICENSE" Pack="true" PackagePath="" Link="LICENSE" />
    <None Include="../NOTICE.md" Pack="true" PackagePath="" Link="NOTICE.md" />
    <None Include="../THIRD_PARTY_NOTICES.md" Pack="true" PackagePath="" Link="THIRD_PARTY_NOTICES.md" />
    <None Include="../README.md" Pack="true" PackagePath="" Link="README.md" />
    <None Update="symbol.png" Pack="true" PackagePath="" />
  </ItemGroup>
</Project>
